{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Builds outside the OneDrive-synced tree: syncing object files mid-build corrupts them (docs/PLAN.md risk table).",
      "binaryDir": "$env{LOCALAPPDATA}/MathfBuild/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ninja",
      "hidden": true,
      "inherits": "base",
      "description": "Single-config command-line builds; each preset pins its own CMAKE_BUILD_TYPE.",
      "generator": "Ninja"
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC x64 Release",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC x64 Debug",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "clang-release",
      "displayName": "clang-cl x64 Release",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "scalar-release",
      "displayName": "Scalar fallback (CI coverage)",
      "description": "Same toolchain as msvc-release so the only variable is the backend.",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "MATHF_FORCE_SCALAR": "ON"
      }
    },
    {
      "name": "sse2-release",
      "displayName": "SSE2 baseline (no AVX2 or SSE4.1)",
      "description": "Compiles the fallback paths that every other preset optimizes away: dot products without dpps, Select without blendv, multiply-add without FMA.",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "MATHF_BASELINE_SSE2": "ON"
      }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 solution (x64)",
      "description": "Generates Mathf.sln so the whole project can be built, run, and debugged from the IDE. Multi-config: the configuration is picked in Visual Studio, so CMAKE_BUILD_TYPE is deliberately left unset.",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "host=x64", "strategy": "set" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "scalar-release", "configurePreset": "scalar-release" },
    { "name": "sse2-release", "configurePreset": "sse2-release" },
    {
      "name": "vs2026-release",
      "displayName": "VS2026 solution - Release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "vs2026-debug",
      "displayName": "VS2026 solution - Debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "scalar-release",
      "configurePreset": "scalar-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sse2-release",
      "configurePreset": "sse2-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2026-release",
      "displayName": "VS2026 solution - Release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2026-debug",
      "displayName": "VS2026 solution - Debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
